# Quantum Computing Configuration
QUANTUM_ENABLED=true
PQC_ENABLED=true
CUDA_Q_TARGET=simulator
NUM_QUBITS=4

# Risk Scoring Parameters
RISK_ALGORITHM=ensemble
VQE_DEPTH=2
QAOA_LAYERS=2
MONTE_CARLO_SAMPLES=1000

# PQC Configuration
PQC_KEM_ALGORITHM=Kyber768
PQC_SIG_ALGORITHM=Dilithium3
KEY_ROTATION_DAYS=365

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# API Configuration
API_HOST=0.0.0.0
API_PORT=8080
API_DEBUG=false

# Docker
DOCKER_IMAGE_TAG=latest
CONTAINER_REGISTRY=ghcr.io
